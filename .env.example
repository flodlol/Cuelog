# Copy to settings.env (or set as environment variables). You can also enter these in Cuelog → Settings.
# Never commit the real file.

# Required for scrobbling: https://www.last.fm/api/account/create
LASTFM_API_KEY=PASTE_YOUR_KEY_HERE
LASTFM_API_SECRET=PASTE_YOUR_SHARED_SECRET_HERE

# Optional: automatic Spotify matching (client-credentials flow) https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: SoundCloud account features (needs an approved SoundCloud app). Register the redirect URI below.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:8765/soundcloud/callback
